<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Ratings y reseñas - <%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    body {
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .wrap {
      max-width: 900px;
      margin: 40px auto;
      background: #121212;
      padding: 24px;
      border-radius: 12px;
      border: 1px solid #333;
    }
    h1 {
      color: #ffd700;
      margin-top: 0;
      margin-bottom: 16px;
    }
    .item {
      padding: 16px 0;
      border-bottom: 1px solid #333;
    }
    .item:last-child { border-bottom: none; }
    .sentence {
      font-size: 1rem;
      margin-bottom: 6px;
    }
    .username {
      font-weight: 700;
      color: #ffd700;
    }
    .time-ago {
      font-size: 0.85rem;
      color: #aaa;
    }
    .review-text {
      margin-top: 8px;
      color: #ddd;
      white-space: pre-wrap;
    }
    .stars {
      color: #ffd700;
      font-weight: 700;
    }
    .btn-row {
      margin-top: 20px;
      display: flex;
      gap: 12px;
    }
    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
    }
    .btn-primary {
      background: #ffd700;
      color: #1a1a1a;
    }
    .btn-secondary {
      background: #1a1a1a;
      color: #ffd700;
      border: 2px solid #ffd700;
    }
  </style>
</head>
<body>
  <%- include('common/navbar.ejs', { toSearch: null }) -%>

  <div class="wrap">
    <h1>Ratings y reseñas de <%= title %></h1>

    <% if (!reviews || reviews.length === 0) { %>
      <p>Nadie ha dejado rating ni reseña todavía para esta película.</p>
    <% } else { %>
      <% reviews.forEach(function(r) { 
          const filled = r.rating || 0;
          const empty = 5 - filled;
          let stars = "";
          for (let i = 0; i < filled; i++) stars += "★";
          for (let i = 0; i < empty; i++) stars += "☆";
      %>
        <div class="item">
          <div class="sentence">
            <span class="username"><%= r.username %></span>
            calificó
            <span><%= title %></span>
            con
            <span class="stars"><%= stars %></span>
            (<%= r.rating || '-' %>/5)
          </div>
          <% if (r.timeAgo) { %>
            <div class="time-ago"><%= r.timeAgo %></div>
          <% } %>
          <div class="review-text"><%= r.content %></div>
        </div>
      <% }) %>
    <% } %>

    <div class="btn-row">
      <a class="btn btn-secondary" href="/pelicula/<%= movieId %>">
        Volver a la película
      </a>
      <a class="btn btn-primary" href="/pelicula/<%= movieId %>/review">
        Hacer rating / Escribir reseña
      </a>
    </div>
  </div>

  <%- include('common/footer.ejs') -%>
</body>
</html>
